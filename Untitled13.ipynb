ss 'pandas.core.frame.DataFrame'>\n","RangeIndex: 15000 entries, 0 to 14999\n","Data columns (total 6 columns):\n"," #   Column            Non-Null Count  Dtype  \n","---  ------            --------------  -----  \n"," 0   order_id          15000 non-null  object \n"," 1   customer_id       15000 non-null  int64  \n"," 2   order_date        15000 non-null  object \n"," 3   order_amount      15000 non-null  float64\n"," 4   shipping_address  15000 non-null  object \n"," 5   order_status      15000 non-null  object \n","dtypes: float64(1), int64(1), object(4)\n","memory usage: 703.3+ KB\n","None\n","Payments DataFrame Info:\n","<class 'pandas.core.frame.DataFrame'>\n","RangeIndex: 15000 entries, 0 to 14999\n","Data columns (total 6 columns):\n"," #   Column          Non-Null Count  Dtype  \n","---  ------          --------------  -----  \n"," 0   payment_id      15000 non-null  object \n"," 1   order_id        15000 non-null  object \n"," 2   payment_date    15000 non-null  object \n"," 3   payment_amount  15000 non-null  float64\n"," 4   payment_method  15000 non-null  object \n"," 5   payment_status  15000 non-null  object \n","dtypes: float64(1), object(5)\n","memory usage: 703.3+ KB\n","None\n"]}]},{"cell_type":"code","source":["# Read and prepare data\n","orders_df = pd.read_csv('customer_orders.csv')\n","orders_df['order_date'] = pd.to_datetime(orders_df['order_date'])"],"metadata":{"id":"3ajlVi1m3999","executionInfo":{"status":"ok","timestamp":1745986155977,"user_tz":-330,"elapsed":34,"user":{"displayName":"0174_ECE _Lakshminarayana","userId":"16618065038597808356"}}},"execution_count":6,"outputs":[]},{"cell_type":"code","source":["# Create cohort month for each customer (first purchase month)\n","cohort_data = orders_df.groupby('customer_id').agg({\n","    'order_date': lambda x: x.min().strftime('%Y-%m')\n","}).reset_index()\n","cohort_data.columns = ['customer_id', 'cohort_month']"],"metadata":{"id":"rHyZ6erG39zR","executionInfo":{"status":"ok","timestamp":1745986158597,"user_tz":-330,"elapsed":633,"user":{"displayName":"0174_ECE _Lakshminarayana","userId":"16618065038597808356"}}},"execution_count":7,"outputs":[]},{"cell_type":"code","source":["# Merge cohort data back to orders\n","orders_with_cohort = orders_df.merge(cohort_data, on='customer_id')"],"metadata":{"id":"x_YM1ucj39jp","executionInfo":{"status":"ok","timestamp":1745986160414,"user_tz":-330,"elapsed":4,"user":{"displayName":"0174_ECE _Lakshminarayana","userId":"16618065038597808356"}}},"execution_count":8,"outputs":[]},{"cell_type":"code","source":["# Calculate months since first purchase\n","orders_with_cohort['cohort_month'] = pd.to_datetime(orders_with_cohort['cohort_month'])\n","# Calculate the difference in months using .n attribute\n","orders_with_cohort['months_since_first_purchase'] = (orders_with_cohort['order_date'].dt.to_period('M') -\n","                                                     orders_with_cohort['cohort_month'].dt.to_period('M')).apply(lambda x: x.n)"],"metadata":{"id":"vu8wwdW637yl","executionInfo":{"status":"ok","timestamp":1745986161725,"user_tz":-330,"elapsed":47,"user":{"displayName":"0174_ECE _Lakshminarayana","userId":"16618065038597808356"}}},"execution_count":9,"outputs":[]},{"cell_type":"code","source":["# Create retention matrix\n","cohort_sizes = orders_with_cohort.groupby('cohort_month')['customer_id'].nunique()\n","retention_matrix = orders_with_cohort.groupby(['cohort_month', 'months_since_first_purchase'])['customer_id'].nunique().unstack()"],"metadata":{"id":"PAdnHBsp4M5b","executionInfo":{"status":"ok","timestamp":1745986163488,"user_tz":-330,"elapsed":73,"user":{"displayName":"0174_ECE _Lakshminarayana","userId":"16618065038597808356"}}},"execution_count":10,"outputs":[]},{"cell_type":"code","source":["# Calculate retention rates\n","retention_rates = retention_matrix.div(cohort_sizes, axis=0) * 100"],"metadata":{"id":"ZwpxZrnR4Mzf","executionInfo":{"status":"ok","timestamp":1745986165546,"user_tz":-330,"elapsed":4,"user":{"displayName":"0174_ECE _Lakshminarayana","userId":"16618065038597808356"}}},"execution_count":11,"outputs":[]},{"cell_type":"code","source":["# Plot heatmap\n","plt.figure(figsize=(15, 8))\n","sns.heatmap(retention_rates, annot=True, fmt='.1f', cmap='YlOrRd')\n","plt.title('Customer Cohort Retention Analysis (%)')\n","plt.xlabel('Months Since First Purchase')\n","plt.ylabel('Cohort Month')\n","plt.tight_layout()\n","plt.show()"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":781},"id":"oAPvuXbA4Uzh","executionInfo":{"status":"ok","timestamp":1745986171193,"user_tz":-330,"elapsed":4433,"user":{"displayName":"0174_ECE _Lakshminarayana","userId":"16618065038597808356"}},"outputId":"712db4c5-d0d0-42ea-d5c7-be6c2b3d98ea"},"execution_count":12,"outputs":[{"output_type":"display_data","data":{"text/plain":["<Figure size 1500x800 with 2 Axes>"],"image/png":"\n"},"metadata":{}}]},{"cell_type":"markdown","source":["Explanation:\n","\n","The heatmap shows the retention rates (in percentage) for customer cohorts over time.\n","\n","The y-axis represents the cohort month (i.e., the month customers made their first purchase).\n","The x-axis indicates the number of months since the first purchase.\n","Each cell's value represents the percentage of the original cohort that made additional purchases in that subsequent month.\n","\n","Additionally, we printed the cohort sizes and the average retention rates across months:"],"metadata":{"id":"gHlJxrYN5KVF"}},{"cell_type":"code","source":["print(\"Cohort Sizes (Number of New Customers at Month 0):\")\n","print(cohort_sizes)"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"0i3dcKUY4UuM","executionInfo":{"status":"ok","timestamp":1745986176505,"user_tz":-330,"elapsed":14,"user":{"displayName":"0174_ECE _Lakshminarayana","userId":"16618065038597808356"}},"outputId":"ca76c43b-6068-4af2-fbbf-0f84e6b6cb48"},"execution_count":13,"outputs":[{"output_type":"stream","name":"stdout","text":["Coho